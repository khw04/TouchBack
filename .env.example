# Server-local configuration template. Never commit the actual .env.
# Copy to local .env after backend setup. Never commit real keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low

# Development only: Mock observations are not physical sensor measurements.
TOUCHBACK_EXECUTION_MODE=backend_stub
TOUCHBACK_DEMO_ENABLED=false
TOUCHBACK_MOCK_SCENARIO=normal
